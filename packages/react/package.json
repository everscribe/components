{
  "name": "@everscribe/components-react",
  "version": "0.1.0",
  "description": "Embeddable React component for Everscribe audit events.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/everscribe/components.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/everscribe/components/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/everscribe/components/issues"
  },
  "keywords": [
    "everscribe",
    "audit",
    "events",
    "react",
    "embed"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@everscribe/components-core": "workspace:*",
    "@everscribe/components-styles": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
